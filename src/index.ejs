          <div class="info">
            By <a href="https://www.pixiv.net/en/users/43729036">Yaya</a> •
            2026-04-03
          </div>
          <p>
            <a href="https://yayasama100lovex.booth.pm/items/8158971">Booth</a>
          </p>
        </div>
      </div>

      <div class="card" id="lonely-lose">
        <%- include("preview.ejs", { dir: "Yaya/Lonely Lose", all_images }) %>
