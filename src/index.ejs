            By <a href="https://www.pixiv.net/en/users/43729036">Yaya</a> •
            2025-11-04
          </div>
          <p>
            <a href="https://yayasama100lovex.booth.pm/items/7617747">Booth</a>
          </p>
        </div>
      </div>

      <div class="card" id="devils-lover-2">
        <%- include("preview.ejs", { dir: "Yaya/Devil_s Lover 2", all_images })
        %>
