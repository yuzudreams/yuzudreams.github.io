          <div class="info">
            By <a href="https://www.pixiv.net/en/users/43729036">Yaya</a> •
            2026-03-18
          </div>
          <p>
            <a href="https://yayasama100lovex.booth.pm/items/8094931">Booth</a>
          </p>
        </div>
      </div>

      <div class="card" id="the-secret-sleepover">
        <%- include("preview.ejs", { dir: "Yaya/The Secret Sleepover",
        all_images }) %>
        <div>
          <h3>The Secret Sleepover</h3>
          <div class="info">
            By <a href="https://www.pixiv.net/en/users/43729036">Yaya</a> •
            2026-03-09
          </div>
          <p>
            <a href="https://yayasama100lovex.booth.pm/items/8067510">Booth</a>
          </p>
        </div>
      </div>

      <div class="card" id="wanting-more">
        <%- include("preview.ejs", { dir: "Yaya/Wanting More", all_images }) %>
        <div>
          <h3>Wanting More</h3>
          <div class="info">
            By <a href="https://www.pixiv.net/en/users/43729036">Yaya</a> •
            2026-06-17
          </div>
          <p>
            <a href="https://yayasama100lovex.booth.pm/items/8517923">Booth</a>
          </p>
        </div>
      </div>
    </section>

    <div id="fullscreen" class="splide" role="group">
      <button class="fullscreen">
        <%- include("svg/fullscreen-exit.svg") %>
      </button>
      <div class="splide__track">
        <ul class="splide__list">
          <% for (const img of all_images) { %>
          <li class="splide__slide">
            <img src="<%= img %>" />
          </li>
          <% } %>
        </ul>
