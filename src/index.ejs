<!DOCTYPE html>
<html lang="<%= language %>">
  <head>
    <title><%= t.title %></title>
  </head>
  <body>
    <%- include("navbar.ejs") %>
    <header>
      <div class="logo">
        <h1><%= t.title %></h1>
        <img
          src="<%= asset('assets/logo.png') %>"
          alt="Capybara sleeping next to giant yuzu fruit"
          width="300"
          height="200"
        />
      </div>
      <div class="series-carousel">
        <div class="splide" role="group">
          <div class="splide__track">
            <ul class="splide__list">
              <li class="splide__slide">
                <div>
                  <a href="#asuka-and-misaki">
                    <img
                      src="<%= asset('assets/Asuka and Misaki/cover.jpg') %>"
                    />
                  </a>
                </div>
              </li>
              <li class="splide__slide">
                <div>
                  <a href="#ame-nochi-yuki">
                    <img
                      src="<%= asset('assets/Ame nochi Yuki/Ch2p01.webp') %>"
                    />
                  </a>
                  <div class="icons">
                    <a
                      href="https://www.pixiv.net/user/122109038/series/315614"
                    >
                      <%- include("../assets/logo/pixiv-r.svg") %>
                    </a>
                    <a href="https://sirainu.fanbox.cc/">
                      <img
                        src="<%= asset('assets/logo/fanbox.webp') %>"
                        alt="pixivFANBOX"
                      />
                    </a>
                  </div>
                </div>
              </li>
              <li class="splide__slide">
                <div>
                  <a href="#blooddiary0">
                    <img
                      src="<%= asset('assets/Yaya/BLOODDIARY0/ch0p01.webp') %>"
                    />
                  </a>
                  <div class="icons">
                    <a href="https://yayasama100lovex.booth.pm/items/7587492">
                      <%- include("../assets/logo/booth_logo_icon.svg") %>
                    </a>
                  </div>
                </div>
              </li>
              <li class="splide__slide">
                <div>
                  <a href="#the-secret-sleepover">
                    <img
                      src="<%= asset('assets/Yaya/The Secret Sleepover/Ch1p01.webp') %>"
                    />
                  </a>
                  <div class="icons">
                    <a href="https://yayasama100lovex.booth.pm/items/8067510">
                      <%- include("../assets/logo/booth_logo_icon.svg") %>
                    </a>
                  </div>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section id="series">
        <%- include("section.ejs") %>

        <h2><%= t.series %></h2>

        <% const all_images = []; %>

        <div class="card" id="asuka-and-misaki">
          <%- include("preview.ejs", { dir: "Asuka and Misaki", all_images }) %>
          <div>
            <h3><%= t.asuka_and_misaki.name %></h3>
            <div class="info">
              <%= t.by %><a href="https://www.pixiv.net/en/users/16115437">
                <%= t.anjinneko %>
              </a>
              •
              <%= t.coming_soon %>
            </div>
            <p>
              <a href="https://x.com/Anjinneko57931/status/2095632937979179198">
                <%= t.asuka_and_misaki.released %>
              </a>
            </p>
          </div>
        </div>

        <div class="card" id="ame-nochi-yuki">
          <%- include("preview.ejs", { dir: "Ame nochi Yuki", all_images }) %>
          <div>
            <h3><%= t.ame_nochi_yuki.name %></h3>
            <div class="info">
              <%= t.by %><a href="https://sirainu.fanbox.cc/">
                <%= t.shirainu %>
              </a>
              • 2025-12-11–
            </div>
            <p>
              <a href="https://www.pixiv.net/user/122109038/series/315614">
                pixiv
              </a>
              •
              <a href="https://sirainu.fanbox.cc/">Fanbox</a>
            </p>
            <p><%= t.ame_nochi_yuki.available %></p>
          </div>
        </div>

        <div class="card" id="blooddiary0">
