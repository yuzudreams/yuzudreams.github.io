            2025-10-28
          </div>
          <p>
            <a href="https://yayasama100lovex.booth.pm/items/7587492">Booth</a>
          </p>
        </div>
      </div>

      <div class="card" id="devils-lover-1">
        <%- include("preview.ejs", { dir: "Yaya/Devil_s Lover 1", all_images })
        %>
        <div>
          <h3>Devil’s Lover 1</h3>
